# OpenClaw Gateway
# Leave disabled unless you actively run OpenClaw locally.
OPENCLAW_GATEWAY_ENABLED=false
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# Set true if you want Mission Control to keep retrying when OpenClaw is down.
OPENCLAW_GATEWAY_RETRY=false

# Database
DATABASE_PATH=./data/mission-control.db

# Workspace (path to your OpenClaw workspace)
WORKSPACE_PATH=/Users/eduardo/.openclaw/workspace
